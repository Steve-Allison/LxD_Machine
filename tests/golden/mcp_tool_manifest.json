          "additionalProperties": false,
          "description": "Typed query-pipeline metadata returned alongside a knowledge answer.\n\nThe ``router_*`` fields are always populated (the router runs first,\non every call). The remaining fields are populated only when\nretrieval + synthesis actually ran \u2014 the \"no retrieval needed\" branch\nfrom the adaptive router returns just the four ``router_*`` values.\nAbsent-when-not-applicable is expressed as ``None`` (booleans / ints)\nor an empty list (id / term collections) so the schema surface is\nalways the same shape.",
          "properties": {
            "dense_top_k": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Dense top-k the router picked for this call. Null when retrieval was skipped."
            },
            "expansion_applied": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Whether ontology expansion added terms. Null when retrieval was skipped."
            },
            "expansion_terms": {
              "description": "Terms added by the expansion pass.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "graph_context_applied": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Whether graph context was prepended to synthesis. Null when skipped."
            },
            "matched_entity_ids": {
              "description": "Ontology entities matched to the question after expansion.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reranking_applied": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Whether the cross-encoder reranker ran. Null when retrieval was skipped."
            },
            "result_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Ranked chunk count after fusion. Null when retrieval was skipped."
            },
            "router_breadth": {
              "description": "Retrieval breadth knob the router picked (drives dense_top_k).",
              "enum": [
                "narrow",
                "standard",
                "broad"
              ],
              "type": "string"
            },
            "router_rationale": {
              "description": "One-line reason the router gave for its retrieve+breadth call.",
              "type": "string"
            },
            "router_retrieve": {
              "description": "Whether the router decided to run retrieval + synthesis.",
              "type": "boolean"
            },
            "router_routed": {
              "description": "True when the router LLM ran; false when we fell back to the default route.",
              "type": "boolean"
            }
          },
          "required": [
            "router_retrieve",
            "router_breadth",
            "router_rationale",
            "router_routed"
          ],
          "type": "object"
        },
        "sentence_citations": {
          "description": "Per-sentence attribution parsed from the inline ``[citation_label]`` markers the synthesis preamble required. Empty ``citation_labels`` on a sentence means the model could not attribute that claim.",
          "items": {
            "additionalProperties": false,
            "description": "One sentence + the citation labels supporting it (MCP-facing shape).\n\nMirrors :class:`lxd.synthesis.citation_alignment.SentenceCitation` but\nlives in the MCP namespace so clients can import a typed model\nalongside the rest of the MCP surface. Sentences with empty\n``citation_labels`` are unattributed claims \u2014 surface them in UIs as\na hallucination risk signal.",
            "properties": {
              "citation_labels": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "answer_status",
        "answer_text",
        "citations",
        "metadata"
      ],
      "type": "object"
    },
    "parameters": [
      "domain",
      "question"
    ],
    "required": [
      "question"
    ]
